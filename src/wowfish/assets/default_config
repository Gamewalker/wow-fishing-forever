# wowfish configuration. Delete any line to go back to its default.

[game]
# Keybind for the Fishing ability on your action bar.
cast_key = "1"
# Keybind for Interact With Target (Options > Keybindings > Targeting).
interact_key = "f"
# Stop fishing after this many minutes. Set to 0 to run Forever!
session_minutes = 0

[vision]
# On-screen size of the interact icon in pixels. 0 = not calibrated; `wowfish calibrate` sets it.
icon_size_px = 0
icon_native_size = 0
# Minimum match score (0..1) to accept the icon.
icon_threshold = 0.75
# Frames wider than this are downscaled before matching.
match_width = 1920

[audio]
# "game": hear only the game's own audio stream (Linux PipeWire, Windows 10 2004+), so music or
# videos in other applications cannot drown the splash. "device": hear the loopback `device`.
capture = "game"
# Loopback device id or name substring, used when capture = "device". Empty = monitor of the
# default output.
device = ""
bite_threshold = 0.66
# Ignore further bites for this many seconds after one fires.
refractory_s = 3.0

[run]
# Recast if the gear icon is not seen this many seconds after casting.
icon_timeout_s = 4.0
# Recast if no splash is heard this many seconds after casting.
cast_timeout_s = 30.0
# Count a miss if the bobber is still there this many seconds after pressing Interact.
loot_timeout_s = 3.0
# Random pause between actions, in seconds.
pause_min_s = 0.5
pause_max_s = 2.0
# How long each key is held down, in milliseconds.
key_hold_ms = 60
# Vary each hold by up to this many milliseconds either way (0 = always exactly key_hold_ms).
key_hold_jitter_ms = 0
# Chance (0 to just below 1) of letting a heard bite go on purpose, like a person who
# looked away. 0 = always press Interact.
skip_bite_chance = 0.0
# Chance (0 to 1) of taking a break after each cast ends; 0 never takes one.
break_chance = 0.0
# How long a break lasts, in seconds (picked at random in this range).
break_min_s = 60.0
break_max_s = 300.0
# Random delay between hearing the splash and pressing Interact, in seconds (at most 2.0).
# 0 and 0 = press right away.
reaction_min_s = 0.0
reaction_max_s = 0.0
# Chance (0 to 1) of a small step after a catch, before the next cast. 0 = never.
# The step holds the first of move_keys, then the second for just as long, so you end up
# where you started. Keep these on strafe left/right (WoW's defaults are q and e).
move_chance = 0.0
move_keys = "q,e"
# Each step is held for a random time between half this and this, in milliseconds.
move_max_ms = 300
